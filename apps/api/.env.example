# Server-side only — this file's real values (.env) must never be
# committed or shipped to the frontend. .env is already gitignored.

PORT=8787

# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://oaopmujdbjswuytazhjs.supabase.co
# The SERVICE ROLE key (or new-style "secret" key) — bypasses RLS.
# Keep this out of any client-side code, ever.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# A random shared secret you also configure as a custom header on the
# Supabase Database Webhook (Database -> Webhooks in the dashboard), so
# this endpoint can reject requests that don't come from Supabase.
# Generate one with: openssl rand -hex 32
WEBHOOK_SHARED_SECRET=change-me

# Email provider — starts with Resend; swappable later (see src/lib/email.ts).
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM="The Film Cage <noreply@yourdomain.edu>"
